PORT=3003
DATA_DIR=.
APP_URL=http://localhost:3003
SESSION_SECRET=replace-this-with-a-long-random-secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-this-before-first-run

# Email (Resend) - used for signup notifications, welcome emails, and password resets
# Get an API key at https://resend.com/api-keys
# For testing without a verified domain, MAIL_FROM can use onboarding@resend.dev
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=onboarding@resend.dev
